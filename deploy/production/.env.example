POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://scheduler:url-encoded-password@postgres:5432/scheduler
BE_IMAGE=ghcr.io/se-fcaps-tool/f-caps-schedule-be:main
CORS_ORIGINS=https://schedule.f-caps.net
FRONTEND_URL=https://schedule.f-caps.net
# Lets the FE subdomain read scheduler_csrf; do not broaden scheduler_session.
COOKIE_DOMAIN=.f-caps.net
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api-schedule.f-caps.net/api/v1/auth/google/callback
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
